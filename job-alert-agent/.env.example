# Copy to .env and fill in. .env is gitignored — never commit it.

# SMTP (Gmail defaults; use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Phone number: 10 digits, no dashes or +1
MY_PHONE_NUMBER=2065551234
# Key from the `carriers:` map in config.yaml (e.g. xfinity, verizon, tmobile)
MY_CARRIER=xfinity

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# With notifier.type: auto, this takes priority over email-to-SMS.
DISCORD_WEBHOOK_URL=

# Only needed if notifier.type is "ntfy" in config.yaml.
# Pick a long, unguessable topic — anyone who knows it can read your alerts.
NTFY_TOPIC=
